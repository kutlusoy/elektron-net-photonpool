# Files that run inside containers or on Linux must keep LF line endings, also when the repository is cloned on Windows
# (git's autocrlf would turn "#!/bin/sh" into "#!/bin/sh\r" and the container fails with
# "exec /usr/local/bin/entrypoint.sh: no such file or directory").
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
docker/node/Dockerfile text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.service text eol=lf
Caddyfile* text eol=lf
*.example text eol=lf
*.yml text eol=lf
